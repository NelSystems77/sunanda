# ================================================================
# SUNANDA SPA - PRODUCTION ENVIRONMENT VARIABLES
# ================================================================
#
# Este archivo contiene las variables de entorno para PRODUCCIÓN.
#
# INSTRUCCIONES DE USO:
# 1. Copia este archivo como .env.production en la raíz
# 2. Reemplaza TODOS los valores con credenciales REALES de producción
# 3. Configura estas variables en Vercel Dashboard
# 4. NUNCA subas .env.production a Git
#
# CONFIGURACIÓN EN VERCEL:
# 1. Ve a tu proyecto en Vercel Dashboard
# 2. Settings > Environment Variables
# 3. Agrega cada variable con su valor
# 4. Marca el entorno: Production
#
# ================================================================

# ----------------------------------------------------------------
# FIREBASE PRODUCTION CONFIGURATION
# ----------------------------------------------------------------
# IMPORTANTE: Usa las credenciales del proyecto de PRODUCCIÓN
# NO uses las credenciales de desarrollo aquí

VITE_FIREBASE_API_KEY=AIza_PRODUCTION_KEY_XXXXXXXXXXXXXXXX
VITE_FIREBASE_AUTH_DOMAIN=sunanda-spa-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sunanda-spa-prod
VITE_FIREBASE_STORAGE_BUCKET=sunanda-spa-prod.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:prod_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-PRODUCTION_ID

# ----------------------------------------------------------------
# APPLICATION CONFIGURATION
# ----------------------------------------------------------------

VITE_APP_NAME=SUNANDA Estética y Spa
VITE_APP_URL=https://sunanda-spa.vercel.app

# ----------------------------------------------------------------
# CONTACT & SOCIAL MEDIA
# ----------------------------------------------------------------

VITE_WHATSAPP_NUMBER=50688083390
VITE_FACEBOOK_URL=https://www.facebook.com/sunanda.spa
# VITE_INSTAGRAM_URL=https://www.instagram.com/sunanda.spa

# ----------------------------------------------------------------
# PAYMENT CONFIGURATION - PRODUCTION
# ----------------------------------------------------------------

# IMPORTANTE: Usa LIVE KEY en producción (comienza con pk_live_)
# NUNCA uses TEST KEY en producción
VITE_STRIPE_PUBLIC_KEY=pk_live_XXXXXXXXXXXXXXXXXXXXXXXX

# ----------------------------------------------------------------
# ENVIRONMENT TYPE
# ----------------------------------------------------------------

VITE_ENV=production

# ----------------------------------------------------------------
# ANALYTICS - PRODUCTION
# ----------------------------------------------------------------

# Google Analytics 4 - Producción
VITE_GA_MEASUREMENT_ID=G-PRODUCTION_XXXXXX

# Google Tag Manager - Producción
# VITE_GTM_CONTAINER_ID=GTM-PRODUCTION

# ----------------------------------------------------------------
# SECURITY HEADERS
# ----------------------------------------------------------------

# CORS Origins permitidos en producción
VITE_CORS_ORIGINS=https://sunanda-spa.vercel.app,https://sunanda-spa.com

# ----------------------------------------------------------------
# PERFORMANCE & OPTIMIZATION
# ----------------------------------------------------------------

# Rate Limiting (más estricto en producción)
VITE_RATE_LIMIT=60

# ----------------------------------------------------------------
# FEATURE FLAGS - PRODUCTION
# ----------------------------------------------------------------

VITE_ENABLE_PAYMENTS=true
VITE_ENABLE_BOOKINGS=true
VITE_ENABLE_REVIEWS=true
# VITE_ENABLE_LOYALTY_PROGRAM=false

# ----------------------------------------------------------------
# DEBUG & MONITORING
# ----------------------------------------------------------------

# IMPORTANTE: SIEMPRE false en producción
VITE_DEBUG_MODE=false
VITE_ENABLE_DEVTOOLS=false

# ----------------------------------------------------------------
# PWA CONFIGURATION
# ----------------------------------------------------------------

VITE_SW_URL=/sw.js
VITE_ENABLE_PUSH_NOTIFICATIONS=true

# ----------------------------------------------------------------
# SENTRY (ERROR TRACKING) - OPCIONAL
# ----------------------------------------------------------------

# VITE_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
# VITE_SENTRY_ENVIRONMENT=production
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# ----------------------------------------------------------------
# VERCEL ENVIRONMENT VARIABLES (Auto-inyectadas)
# ----------------------------------------------------------------
# Estas variables son automáticamente inyectadas por Vercel:
# - VERCEL=1
# - VERCEL_ENV=production
# - VERCEL_URL=auto-generated-url.vercel.app
# - VERCEL_GIT_COMMIT_SHA
# - VERCEL_GIT_COMMIT_MESSAGE
# - VERCEL_GIT_COMMIT_AUTHOR_NAME
#
# No necesitas configurarlas manualmente
# ----------------------------------------------------------------

# ================================================================
# CHECKLIST PRE-DEPLOYMENT
# ================================================================
#
# [ ] Firebase configurado para producción
# [ ] Stripe en modo LIVE (no TEST)
# [ ] Analytics ID de producción
# [ ] URL correcta en VITE_APP_URL
# [ ] DEBUG_MODE = false
# [ ] Todas las variables configuradas en Vercel Dashboard
# [ ] Probado en ambiente de staging primero
# [ ] Backup de Firebase antes de deploy
# [ ] DNS configurado (si usas dominio custom)
# [ ] SSL/TLS verificado
# [ ] Service Worker testeado
#
# ================================================================

# ================================================================
# COMANDOS DE DEPLOYMENT
# ================================================================
#
# Build local de producción (testing):
# npm run build
#
# Preview local de producción:
# npm run preview
#
# Deploy a Vercel (automático desde Git):
# git push origin main
#
# Deploy manual a Vercel:
# vercel --prod
#
# ================================================================
