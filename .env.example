# ================================================================
# SUNANDA SPA - ENVIRONMENT VARIABLES
# ================================================================
# 
# Este archivo contiene todas las variables de entorno necesarias
# para el funcionamiento de la aplicación SUNANDA Spa.
#
# INSTRUCCIONES:
# 1. Copia este archivo como .env en la raíz del proyecto
# 2. Reemplaza los valores de ejemplo con tus credenciales reales
# 3. NUNCA subas el archivo .env a Git (está en .gitignore)
# 4. Para producción, usa .env.production
#
# ================================================================

# ----------------------------------------------------------------
# FIREBASE CONFIGURATION
# ----------------------------------------------------------------
# Obtén estos valores desde:
# Firebase Console > Project Settings > General > Your apps
# https://console.firebase.google.com/

VITE_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ----------------------------------------------------------------
# APPLICATION CONFIGURATION
# ----------------------------------------------------------------

# Nombre de la aplicación (aparece en el navegador y PWA)
VITE_APP_NAME=SUNANDA Estética y Spa

# URL base de la aplicación
# Desarrollo: http://localhost:3000
# Producción: https://tu-dominio.com
VITE_APP_URL=http://localhost:3000

# ----------------------------------------------------------------
# CONTACT & SOCIAL MEDIA
# ----------------------------------------------------------------

# WhatsApp (formato: código país + número, sin espacios ni guiones)
# Ejemplo: Costa Rica (+506) 8808-3390 = 50688083390
VITE_WHATSAPP_NUMBER=50688083390

# URL completa de Facebook
VITE_FACEBOOK_URL=https://www.facebook.com/sunanda.spa

# Instagram (opcional)
# VITE_INSTAGRAM_URL=https://www.instagram.com/sunanda.spa

# ----------------------------------------------------------------
# PAYMENT CONFIGURATION
# ----------------------------------------------------------------

# Stripe Public Key (Publishable key)
# Obtén desde: https://dashboard.stripe.com/apikeys
# Importante: Usa la TEST key para desarrollo y LIVE key para producción
# Test key comienza con: pk_test_
# Live key comienza con: pk_live_
VITE_STRIPE_PUBLIC_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXX

# ----------------------------------------------------------------
# ENVIRONMENT TYPE
# ----------------------------------------------------------------

# Opciones: development | staging | production
# Esta variable controla ciertos comportamientos de la app:
# - development: muestra logs, errores detallados, hot reload
# - staging: similar a producción pero en ambiente de pruebas
# - production: optimizado, sin logs, con analytics
VITE_ENV=development

# ----------------------------------------------------------------
# ANALYTICS (OPCIONAL)
# ----------------------------------------------------------------

# Google Analytics 4 Measurement ID
# Obtén desde: https://analytics.google.com/
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Tag Manager Container ID
# VITE_GTM_CONTAINER_ID=GTM-XXXXXXX

# ----------------------------------------------------------------
# EMAIL CONFIGURATION (OPCIONAL)
# ----------------------------------------------------------------

# Si usas EmailJS para formularios de contacto
# Obtén desde: https://www.emailjs.com/
# VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
# VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
# VITE_EMAILJS_PUBLIC_KEY=your_public_key

# ----------------------------------------------------------------
# MAPS & LOCATION (OPCIONAL)
# ----------------------------------------------------------------

# Google Maps API Key (si usas mapas)
# Obtén desde: https://console.cloud.google.com/
# VITE_GOOGLE_MAPS_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Coordenadas del spa (latitud, longitud)
# VITE_SPA_LATITUDE=9.9281
# VITE_SPA_LONGITUDE=-84.0907

# ----------------------------------------------------------------
# PWA CONFIGURATION (OPCIONAL)
# ----------------------------------------------------------------

# URL del Service Worker (por defecto /sw.js)
# VITE_SW_URL=/sw.js

# Habilitar notificaciones push
# VITE_ENABLE_PUSH_NOTIFICATIONS=false

# ----------------------------------------------------------------
# SECURITY & PERFORMANCE
# ----------------------------------------------------------------

# CORS Origins permitidos (separados por coma)
# VITE_CORS_ORIGINS=http://localhost:3000,https://sunanda-spa.com

# Rate Limiting (solicitudes por minuto)
# VITE_RATE_LIMIT=100

# ----------------------------------------------------------------
# FEATURE FLAGS (OPCIONAL)
# ----------------------------------------------------------------

# Habilitar/deshabilitar características específicas
# VITE_ENABLE_PAYMENTS=true
# VITE_ENABLE_BOOKINGS=true
# VITE_ENABLE_REVIEWS=false
# VITE_ENABLE_LOYALTY_PROGRAM=false

# ----------------------------------------------------------------
# DEBUG & DEVELOPMENT
# ----------------------------------------------------------------

# Mostrar logs en consola (solo development)
# VITE_DEBUG_MODE=true

# Habilitar React DevTools
# VITE_ENABLE_DEVTOOLS=true

# ----------------------------------------------------------------
# NOTES
# ----------------------------------------------------------------
# 
# Seguridad:
# - Las variables con prefijo VITE_ son públicas (se exponen al cliente)
# - NO incluyas secrets, tokens privados o API keys privadas aquí
# - Para secretos del backend, usa variables sin prefijo VITE_
#
# Validación:
# - Revisa src/shared/config/env.ts para validaciones
# - La app no iniciará si faltan variables requeridas
#
# Múltiples ambientes:
# - .env - Variables locales (no subir a Git)
# - .env.example - Template (sí subir a Git)
# - .env.development - Desarrollo específico
# - .env.production - Producción específica
# - .env.staging - Staging específico
#
# ================================================================
